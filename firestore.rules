rules_version = '2';

// Single-user dashboard.
//
// Sicherheit: Zugriff ist explizit auf die Owner-E-Mail beschraenkt.
// Selbst wenn versehentlich ein weiterer Firebase-Auth-User angelegt
// wuerde, kaeme er hier nicht rein. Zusaetzlich muss die E-Mail
// verifiziert sein.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'yusuf@kolac-digital.de'
        && request.auth.token.email_verified == true;
    }

    // Blogartikel sind die einzige Ausnahme: was veroeffentlicht ist,
    // darf jeder lesen. Genau dafuer ist es schliesslich da. Entwuerfe
    // bleiben privat, weil die Abfrage auf status == 'published'
    // eingeschraenkt sein muss, damit sie ueberhaupt erlaubt wird.
    // Geschrieben wird weiterhin nur vom Inhaber.
    match /blogPosts/{postId} {
      allow read: if isOwner() || resource.data.status == 'published';
      allow write: if isOwner();
    }

    // Alles andere bleibt vollstaendig privat.
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
